<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-width: 1px;" stylesheets="@dashboard.css" prefWidth="420.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartdine.controller.UiMergeController">
   <padding>
      <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
   </padding>
   <children>
      <!-- Header Section -->
      <VBox spacing="6.0">
         <children>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
               <children>
                  <!-- Beautiful Merge Icon (SVG) -->
                  <StackPane style="-fx-background-color: #ECFDF5; -fx-background-radius: 8px; -fx-padding: 8px;">
                     <children>
                        <SVGPath content="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z M5.5 5A1.5 1.5 0 004 6.5v8A1.5 1.5 0 005.5 16h13a1.5 1.5 0 001.5-1.5v-8A1.5 1.5 0 0018.5 5h-13z" fill="#0A4F34" scaleX="1.2" scaleY="1.2" />
                     </children>
                  </StackPane>
                  <Label text="Merge Tables" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0F172A; -fx-font-family: 'Inter', 'Segoe UI';" />
               </children>
            </HBox>
            <Label text="Combine two or more vacant tables to host larger groups under a single billing session." 
                   style="-fx-font-size: 13px; -fx-text-fill: #64748B; -fx-font-family: 'Inter', 'Segoe UI';" wrapText="true" />
         </children>
      </VBox>
      
      <Separator style="-fx-opacity: 0.5;" />
      
      <!-- Selection Title -->
      <Label text="Select Vacant Tables to Merge:" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #334155; -fx-font-family: 'Inter', 'Segoe UI';" />
      
      <!-- Scrollable Container -->
      <ScrollPane prefHeight="220.0" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px;">
         <content>
            <VBox fx:id="tablesContainer" spacing="8.0" style="-fx-background-color: #F8FAFC; -fx-padding: 8;">
               <!-- Populated dynamically with premium checkable cards -->
            </VBox>
         </content>
      </ScrollPane>
      
      <!-- Notes / Special Context -->
      <VBox spacing="6.0">
         <children>
            <Label text="Session Notes / Context (Optional):" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #334155; -fx-font-family: 'Inter', 'Segoe UI';" />
            <TextField fx:id="notesField" promptText="e.g. Host table by the window, VIP guests" 
                       style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10 12; -fx-font-size: 13px; -fx-text-fill: #0F172A; -fx-font-family: 'Inter', 'Segoe UI';" />
         </children>
      </VBox>
      
      <Separator style="-fx-opacity: 0.5;" />
      
      <!-- Action Buttons -->
      <HBox spacing="12.0" alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="cancelBtn" text="Cancel" onAction="#handleCancel" 
                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: 700; -fx-padding: 10 20; -fx-background-radius: 6px; -fx-cursor: hand;" />
            <Button fx:id="mergeBtn" text="Merge Tables" onAction="#handleMerge" 
                    style="-fx-background-color: #0A4F34; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: 700; -fx-padding: 10 24; -fx-background-radius: 6px; -fx-cursor: hand;" />
         </children>
      </HBox>
   </children>
</VBox>
