<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" 
            style="-fx-background-color: #0A1913;" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.smartdine.controller.UiBillingSetupController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <!-- Title Bar -->
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #0F2D22; -fx-padding: 12 20; -fx-background-radius: 8;">
                    <children>
                        <Label text="🧾 Thermal Receipt &amp; Billing Layout Customizer" textFill="#E2F1E7">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Live ESC/POS Engine" textFill="#4ADE80">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Content Split -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <!-- Left: Control Panel -->
                    <VBox prefWidth="420.0" spacing="12.0" style="-fx-background-color: #0F2A20; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #1E4D3B; -fx-border-radius: 8;">
                        <children>
                            <Label text="Header &amp; Business Info" textFill="#2DD4BF">
                                <font><Font name="System Bold" size="14.0" /></font>
                            </Label>
                            
                            <VBox spacing="4.0">
                                <Label text="Restaurant Name" textFill="#94A3B8" />
                                <TextField fx:id="nameField" promptText="Surabhi Foods" style="-fx-background-color: #0A1913; -fx-text-fill: white; -fx-border-color: #1E4D3B; -fx-border-radius: 4;" />
                            </VBox>

                            <VBox spacing="4.0">
                                <Label text="Address Line" textFill="#94A3B8" />
                                <TextField fx:id="addressField" promptText="Main Road, Calicut" style="-fx-background-color: #0A1913; -fx-text-fill: white; -fx-border-color: #1E4D3B; -fx-border-radius: 4;" />
                            </VBox>

                            <VBox spacing="4.0">
                                <Label text="GSTIN Number" textFill="#94A3B8" />
                                <TextField fx:id="gstinField" promptText="32AAAAA0000A1Z5" style="-fx-background-color: #0A1913; -fx-text-fill: white; -fx-border-color: #1E4D3B; -fx-border-radius: 4;" />
                            </VBox>

                            <Separator style="-fx-background-color: #1E4D3B;" />

                            <Label text="Printer Layout Options" textFill="#2DD4BF">
                                <font><Font name="System Bold" size="14.0" /></font>
                            </Label>

                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <children>
                                    <Label text="Paper Width:" textFill="#94A3B8" />
                                    <ComboBox fx:id="paperSizeBox" prefWidth="120.0" style="-fx-background-color: #0A1913; -fx-mark-color: white;" />
                                </children>
                            </HBox>

                            <CheckBox fx:id="showTaxCheck" selected="true" text="Show CGST/SGST Breakdown on Receipt" textFill="#E2F1E7" />

                            <VBox spacing="4.0">
                                <Label text="Footer Message" textFill="#94A3B8" />
                                <TextField fx:id="footerField" promptText="Thank you! Visit again." style="-fx-background-color: #0A1913; -fx-text-fill: white; -fx-border-color: #1E4D3B; -fx-border-radius: 4;" />
                            </VBox>

                            <Region VBox.vgrow="ALWAYS" />

                            <!-- Buttons -->
                            <HBox spacing="10.0">
                                <children>
                                    <Button fx:id="resetBtn" onAction="#handleReset" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Reset" />
                                    <Button fx:id="saveBtn" onAction="#handleSave" prefHeight="35.0" prefWidth="240.0" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="💾 Save Layout Configuration" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- Right: Live Receipt Monospace Preview -->
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #0F2A20; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #1E4D3B; -fx-border-radius: 8;">
                        <children>
                            <Label text="Live ESC/POS Thermal Receipt Simulation" textFill="#4ADE80">
                                <font><Font name="System Bold" size="14.0" /></font>
                            </Label>
                            <TextArea fx:id="previewArea" editable="false" prefHeight="500.0" 
                                      style="-fx-control-inner-background: #040D09; -fx-text-fill: #A7F3D0; -fx-font-family: 'Courier New', monospace; -fx-font-size: 13px; -fx-font-weight: bold;" 
                                      VBox.vgrow="ALWAYS" />
                        </children>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
