                                          <Label fx:id="ordersCancelledLabel" text="0" styleClass="orders-stat-value" />
                                          <Label text="Today's cancelled" styleClass="orders-stat-subtitle" />
                                       </children>
                                    </VBox>
                                    <StackPane styleClass="orders-stat-icon-container, darkred-circle">
                                       <children>
                                          <!-- SVG Circle with cross X in the center -->
                                          <SVGPath content="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z" styleClass="orders-stat-icon" />
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>

                        <!-- B. MAIN CONTENT GRID (LIST + DETAILS) -->
                        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                           <children>
                              
                              <!-- LEFT: ORDERS LIST PANEL -->
                              <VBox spacing="12.0" styleClass="orders-list-panel" HBox.hgrow="ALWAYS">
                                 <children>
                                    <!-- Search & Status Bar -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="orders-search-container" HBox.hgrow="ALWAYS">
                                             <children>
                                                <SVGPath content="M11 19a8 8 0 100-16 8 8 0 000 16z M21 21l-4.35-4.35" styleClass="search-icon" />
                                                <TextField fx:id="ordersSearchField" promptText="Search by Order ID, Table, Customer name..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                                             </children>
                                          </HBox>
                                          <ComboBox fx:id="ordersStatusComboBox" prefWidth="150.0" styleClass="status-combobox" />
                                       </children>
                                    </HBox>

                                    <!-- Segmented Tabs Bar -->
                                    <HBox styleClass="orders-tabs-bar" spacing="5.0">
                                       <children>
                                          <Button fx:id="ordersTabAllBtn" text="All" styleClass="orders-tab-btn, active" onAction="#handleOrdersTabAll">
                                             <graphic>
                                                <Label fx:id="ordersTabAllBadge" text="0" styleClass="tab-badge" />
                                             </graphic>
                                          </Button>
                                          <Button fx:id="ordersTabDineInBtn" text="Dine-In" styleClass="orders-tab-btn" onAction="#handleOrdersTabDineIn">
                                             <graphic>
                                                <Label fx:id="ordersTabDineInBadge" text="0" styleClass="tab-badge" />
                                             </graphic>
                                          </Button>
                                          <Button fx:id="ordersTabDeliveryBtn" text="Delivery" styleClass="orders-tab-btn" onAction="#handleOrdersTabDelivery">
                                             <graphic>
                                                <Label fx:id="ordersTabDeliveryBadge" text="0" styleClass="tab-badge" />
                                             </graphic>
                                          </Button>
                                          <Button fx:id="ordersTabTakeawayBtn" text="Takeaway" styleClass="orders-tab-btn" onAction="#handleOrdersTabTakeaway">
                                             <graphic>
                                                <Label fx:id="ordersTabTakeawayBadge" text="0" styleClass="tab-badge" />
                                             </graphic>
                                          </Button>
                                       </children>
                                    </HBox>

                                    <!-- Custom Table Header -->
                                    <GridPane styleClass="orders-table-header" hgap="10">
                                       <columnConstraints>
                                          <ColumnConstraints percentWidth="12.0" hgrow="ALWAYS" />
                                          <ColumnConstraints percentWidth="22.0" hgrow="ALWAYS" />
                                          <ColumnConstraints percentWidth="23.0" hgrow="ALWAYS" />
                                          <ColumnConstraints percentWidth="18.0" hgrow="ALWAYS" />
                                          <ColumnConstraints percentWidth="15.0" hgrow="ALWAYS" />
                                          <ColumnConstraints percentWidth="10.0" hgrow="ALWAYS" />
                                       </columnConstraints>
                                       <padding>
                                          <Insets top="10" right="10" bottom="10" left="10" />
                                       </padding>
                                       <children>
                                          <Label text="Order ID" styleClass="th-label" GridPane.columnIndex="0" />
                                          <Label text="Source / Table" styleClass="th-label" GridPane.columnIndex="1" />
                                          <Label text="Customer" styleClass="th-label" GridPane.columnIndex="2" />
                                          <Label text="Status" styleClass="th-label" GridPane.columnIndex="3" />
                                          <Label text="Time" styleClass="th-label" GridPane.columnIndex="4" />
                                          <Label text="Amount" styleClass="th-label" alignment="CENTER_RIGHT" maxWidth="Infinity" GridPane.columnIndex="5" />
                                       </children>
                                    </GridPane>

                                    <!-- Scrollable Orders List Container -->
                                    <ScrollPane fitToWidth="true" styleClass="orders-scroll-pane" VBox.vgrow="ALWAYS">
                                       <content>
                                          <VBox fx:id="ordersListContainer" spacing="5.0" />
                                       </content>
                                    </ScrollPane>
                                 </children>
                              </VBox>

                              <!-- RIGHT: ORDER DETAILS PANEL -->
                              <VBox fx:id="orderDetailsPane" styleClass="orders-details-panel" prefWidth="520.0" minWidth="520.0" maxWidth="520.0" visible="false" managed="false">
                                 <children>
                                    <!-- Detail Header Banner (Dark Green edge-to-edge) -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #093325; -fx-background-radius: 12px 12px 0 0; -fx-padding: 16;">
                                       <children>
                                          <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                                             <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                   <children>
                                                      <SVGPath content="M6 2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M9 5h8 M9 9h8 M9 13h5.5a3.5 3.5 0 0 0 0-7H9 M9 13l6 4.5" style="-fx-fill: transparent; -fx-stroke: #A3C6B9; -fx-stroke-width: 1.6;" scaleX="0.95" scaleY="0.95" />
                                                      <Label fx:id="detOrderNumberLabel" text="Order #1089" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 21px; -fx-font-family: 'Outfit', 'Inter', 'Segoe UI', sans-serif;" />
                                                   </children>
                                                </HBox>
                                                <Label fx:id="detOrderMetaLabel" text="Placed at 8 mins ago · Dine-In" style="-fx-text-fill: #A3C6B9; -fx-font-size: 15px; -fx-font-family: 'Outfit', 'Inter', 'Segoe UI', sans-serif;" />
                                             </children>
                                          </VBox>
                                          <Label fx:id="detStatusBadgeLabel" text="• Preparing" styleClass="status-badge preparing" style="-fx-background-radius: 999px; -fx-padding: 4 10; -fx-font-weight: bold; -fx-font-size: 14px; -fx-font-family: 'Outfit', 'Inter', 'Segoe UI', sans-serif;" />
                                       </children>
                                    </HBox>

                                    <!-- Detail Content Body -->
                                    <VBox spacing="0.0" style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
                                       <children>
                                          <!-- 2-Column Info Row (Customer / Table-Waiter) -->
                                          <HBox spacing="16.0" alignment="CENTER_LEFT" style="-fx-padding: 16 16 12 16;">
                                             <children>
                                                <!-- Customer Details Column -->
                                                <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                                                   <children>
                                                      <Label text="CUSTOMER DETAILS" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5C8271;" />
                                                      <HBox spacing="6.0" alignment="CENTER_LEFT">
                                                         <children>
                                                            <SVGPath content="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5z M20 21a8 8 0 0 0-16 0" style="-fx-fill: transparent; -fx-stroke: #5C8271; -fx-stroke-width: 1.6;" scaleX="0.95" scaleY="0.95" />
                                                            <Label fx:id="detCustomerNameLabel" text="Adithyan" style="-fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-size: 17px;" />
                                                         </children>
                                                      </HBox>
                                                   </children>
                                                </VBox>
                                                <!-- Table / Server Column -->
                                                <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                                                   <children>
                                                      <Label text="TABLE / WAITER" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5C8271;" />
                                                      <HBox spacing="6.0" alignment="CENTER_LEFT">
                                                         <children>
                                                            <SVGPath content="M4 19V11H2V9h20v2h-2v8h-2v-8H6v8H4zm6-14h4v4h-4V5z" style="-fx-fill: transparent; -fx-stroke: #5C8271; -fx-stroke-width: 1.6;" scaleX="0.95" scaleY="0.95" />
                                                            <Label fx:id="detTableWaiterLabel" text="Table 12 · Rajesh" style="-fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-size: 17px;" />
                                                         </children>
                                                      </HBox>
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>

                                          <Separator style="-fx-border-color: transparent transparent #E5E7EB transparent; -fx-border-style: solid; -fx-border-width: 0 0 1 0; -fx-padding: 0;" />

                                          <!-- Items Section -->
                                          <VBox spacing="8.0" VBox.vgrow="ALWAYS" style="-fx-padding: 12 16 12 16;">
                                             <children>
                                                <Label text="ITEMS IN ORDER" styleClass="items-section-title" />
                                                <ScrollPane fitToWidth="true" styleClass="details-items-scroll" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                                                   <content>
                                                      <VBox fx:id="detItemsContainer" spacing="2.0" />
                                                   </content>
                                                </ScrollPane>
                                                <!-- Edit Order Search Box -->
                                                <HBox fx:id="detEditSearchBox" alignment="CENTER_LEFT" spacing="8.0" visible="false" managed="false" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10 12;">
                                                   <children>
                                                      <SVGPath content="M11.5 21a9.5 9.5 0 1 0 0-19 9.5 9.5 0 0 0 0 19z M22 22l-2-2" style="-fx-fill: transparent; -fx-stroke: #64748B; -fx-stroke-width: 1.8;" scaleX="0.9" scaleY="0.9" />
                                                      <TextField fx:id="detEditSearchField" promptText="Search menu to add items..." style="-fx-background-color: transparent; -fx-padding: 0; -fx-font-size: 16px; -fx-text-fill: #1E293B;" HBox.hgrow="ALWAYS" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>

                                          <!-- Kitchen Notes -->
                                          <VBox fx:id="detKitchenNotesContainer" spacing="0.0">
                                             <children>
                                                <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB transparent #E5E7EB transparent; -fx-border-width: 1 0 1 0; -fx-padding: 12 16;">
                                                   <children>
                                                      <SVGPath content="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z M12 16v-4 M12 8h.01" style="-fx-fill: transparent; -fx-stroke: #3B82F6; -fx-stroke-width: 1.8;" scaleX="0.9" scaleY="0.9" />
                                                      <HBox spacing="4.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                                          <children>
                                                             <Label text="Kitchen Notes:" style="-fx-font-weight: bold; -fx-text-fill: #0F172A; -fx-font-size: 15px;" />
                                                             <Label fx:id="detKitchenNotesLabel" text="Less Spicy on Paneer Tikka. Veg Biryani without onions." style="-fx-font-size: 15px; -fx-text-fill: #1E293B;" wrapText="true" HBox.hgrow="ALWAYS" />
                                                          </children>
                                                       </HBox>
                                                    </children>
                                                </HBox>
                                             </children>
                                          </VBox>

                                          <!-- Bill Breakdown -->
                                          <VBox spacing="6.0" style="-fx-background-color: #EFF4F1; -fx-padding: 16;">
                                             <children>
                                                <HBox alignment="CENTER_LEFT">
                                                   <children>
                                                      <Label text="Subtotal" style="-fx-text-fill: #1E293B; -fx-font-size: 16px;" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="detSubtotalLabel" text="₹830.00" style="-fx-text-fill: #1E293B; -fx-font-size: 16px;" />
                                                   </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT">
                                                   <children>
                                                      <Label text="CGST (2.5%)" style="-fx-text-fill: #5C8271; -fx-font-size: 16px;" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="detCgstLabel" text="₹20.75" style="-fx-text-fill: #5C8271; -fx-font-size: 16px;" />
                                                   </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT">
                                                   <children>
                                                      <Label text="SGST (2.5%)" style="-fx-text-fill: #5C8271; -fx-font-size: 16px;" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="detSgstLabel" text="₹20.75" style="-fx-text-fill: #5C8271; -fx-font-size: 16px;" />
                                                   </children>
                                                </HBox>
                                                <Separator style="-fx-border-color: transparent transparent #CBD5E1 transparent; -fx-border-style: dashed; -fx-border-width: 0 0 1 0; -fx-padding: 4 0 4 0;" />
                                                 <HBox alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
                                                   <children>
                                                      <Label text="GRAND TOTAL" style="-fx-font-weight: bold; -fx-text-fill: #5C8271; -fx-font-size: 17px;" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label fx:id="detGrandTotalLabel" text="₹871.50" style="-fx-font-weight: 900; -fx-text-fill: #0F172A; -fx-font-size: 28px;" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>

                                          <!-- Actions Panel -->
                                          <VBox spacing="12.0" style="-fx-padding: 16;">
                                             <children>
                                                <HBox spacing="10.0">
                                                   <children>
                                                      <Button fx:id="detPrintKotBtn" text="Print KOT" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10 16;">
                                                         <graphic>
                                                            <SVGPath content="M19 8H5a3 3 0 0 0-3 3v6h4v4h12v-4h4v-6a3 3 0 0 0-3-3z M6 12H8 M14 4H10v4h4V4z M16 14H8v5h8v-5z" style="-fx-fill: transparent; -fx-stroke: #1E293B; -fx-stroke-width: 1.6;" scaleX="0.9" scaleY="0.9" />
                                                         </graphic>
                                                      </Button>
                                                      <Button fx:id="detEditItemsBtn" text="Edit Items" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10 16;">
                                                         <graphic>
                                                            <SVGPath content="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z" style="-fx-fill: transparent; -fx-stroke: #1E293B; -fx-stroke-width: 1.6;" scaleX="0.9" scaleY="0.9" />
                                                         </graphic>
                                                      </Button>
                                                   </children>
                                                </HBox>
                                                <Button fx:id="detActionButton" text="Mark as Ready" maxWidth="Infinity" style="-fx-background-color: #234E3D; -fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8px; -fx-border-radius: 8px;" />
                                                <!-- Edit Actions Container -->
                                                <HBox fx:id="detEditActionsContainer" spacing="10.0" visible="false" managed="false">
                                                   <children>
                                                      <Button fx:id="detCancelEditBtn" text="Cancel" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 17px; -fx-padding: 12 16; -fx-cursor: hand;">
                                                         <graphic>
                                                            <SVGPath content="M18 6L6 18 M6 6l12 12" style="-fx-fill: transparent; -fx-stroke: #1E293B; -fx-stroke-width: 2.0;" scaleX="0.95" scaleY="0.95" />
                                                         </graphic>
                                                      </Button>
                                                      <Button fx:id="detSaveChangesBtn" text="Save Changes" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #234E3D; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 17px; -fx-padding: 12 16; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-cursor: hand;">
                                                         <graphic>
                                                            <SVGPath content="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8" style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2.0;" scaleX="0.95" scaleY="0.95" />
                                                         </graphic>
                                                      </Button>
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>

                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <!-- 2E. KDS VIEW -->
                  <VBox fx:id="kdsView" visible="false" managed="false" VBox.vgrow="ALWAYS">
                     <children>
                        <fx:include fx:id="kdsNative" source="kds_view.fxml" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
                  <!-- 2F. MENU VIEW -->
                  <VBox fx:id="menuView" visible="false" managed="false" VBox.vgrow="ALWAYS">
                     <children>
                        <WebView fx:id="menuWebView" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </VBox>
   </center>
</BorderPane>