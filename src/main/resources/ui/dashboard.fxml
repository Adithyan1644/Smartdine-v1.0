<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.Group?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:id="rootPane" prefWidth="1366.0" prefHeight="800.0" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartdine.controller.UiDashboardController">
   
   <!-- 1. LEFT SIDEBAR -->
   <left>
      <VBox spacing="15.0" styleClass="sidebar" prefWidth="110.0">
         <children>
            <!-- Top spacer for padding since logo is removed -->
            <Region prefHeight="10.0" />
            <Button fx:id="homeBtn" text="Home" styleClass="nav-button, active" maxWidth="Infinity" onAction="#showHomeView">
               <graphic>
                  <SVGPath content="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9zm6 13V12h6v10" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
            <Button fx:id="billingBtn" text="Billing" styleClass="nav-button" maxWidth="Infinity" onAction="#showBillingView">
               <graphic>
                  <SVGPath content="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1zm12 6H8m8 4H8m5 4H8" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
            <Button fx:id="tablesBtn" text="Tables" styleClass="nav-button" maxWidth="Infinity" onAction="#showTablesView">
               <graphic>
                  <SVGPath content="M3 3h7v7H3zm11 0h7v7h-7zm0 11h7v7h-7zM3 14h7v7H3z" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
            <Button fx:id="ordersBtn" text="Orders" styleClass="nav-button" maxWidth="Infinity" onAction="#showOrdersView">
               <graphic>
                  <SVGPath content="M 6 2 h 12 v 20 h -12 z M 9 2 v 3 h 6 v -3 z M 8 9 h 8 M 8 13 h 8 M 8 17 h 6" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
            <Button fx:id="kdsBtn" text="KDS" styleClass="nav-button" maxWidth="Infinity" onAction="#showKdsView">
               <graphic>
                  <SVGPath content="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
            <Button fx:id="menuBtn" text="Menu" styleClass="nav-button" maxWidth="Infinity" onAction="#showMenuView">
               <graphic>
                  <SVGPath content="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2M7 2v20M21 15V2v0a5 5 0 00-5 5v8c0 1.1.9 2 2 2h3zm-3 0v7" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
            <Button text="Inventory" styleClass="nav-button" maxWidth="Infinity">
               <graphic>
                  <SVGPath content="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16zM3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Settings" styleClass="nav-button" maxWidth="Infinity">
               <graphic>
                  <SVGPath content="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" scaleX="1.0" scaleY="1.0" />
               </graphic>
            </Button>
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-button, nav-button-logout" maxWidth="Infinity">
               <graphic>
                  <SVGPath content="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" scaleX="1.1" scaleY="1.1" />
               </graphic>
            </Button>
         </children>
      </VBox>
   </left>

   <!-- 2. MAIN WORKSPACE -->
   <center>
      <VBox>
         <children>
            <!-- A. TOP HEADER BAR (Static) -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="top-header-bar">
               <children>
                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Surabhi SmartDine" styleClass="brand-title" />
                        <Label text="Powered by Oraaco Intelligence" styleClass="brand-subtitle" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER" spacing="8.0" styleClass="search-container">
                     <children>
                        <SVGPath content="M11 19a8 8 0 100-16 8 8 0 000 16z M21 21l-4.35-4.35" styleClass="search-icon" />
                        <TextField promptText="Search or type item name / code (BCM, Butter Chicken...)" prefWidth="350.0" styleClass="search-field" />
                        <Label text="⌘K" styleClass="search-shortcut" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button text="🔄 Sync Web Config" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8 16; -fx-cursor: hand;" onAction="#handleSyncFromCloud" />
                  <Button text="+ Create New Order" styleClass="btn-primary" onAction="#handleCreateNewOrder" />
                  
                  <!-- Notification stack with red badge dot & number 8 -->
                  <StackPane>
                     <Button styleClass="btn-icon">
                        <graphic>
                           <SVGPath content="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" />
                        </graphic>
                     </Button>
                     <Label text="8" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 1 4;" StackPane.alignment="TOP_RIGHT">
                        <StackPane.margin>
                           <Insets top="-2.0" right="-2.0" />
                        </StackPane.margin>
                     </Label>
                  </StackPane>
                  
                  <!-- Top Settings Button with Lucide Gear vector -->
                  <Button styleClass="btn-icon">
                     <graphic>
                        <SVGPath content="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
                     </graphic>
                  </Button>
                  
                  <HBox alignment="CENTER" spacing="8.0" styleClass="profile-box">
                     <children>
                        <Label text="M" styleClass="profile-avatar" />
                        <VBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Manager" styleClass="profile-name" />
                              <Label text="Main Outlet" styleClass="profile-role" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- Dynamic Workspace StackPane -->
            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  
                  <!-- 2A. HOME/DASHBOARD VIEW -->
                  <VBox fx:id="dashboardView" spacing="15.0" styleClass="main-content-area" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                     </padding>
                     <children>
                        <!-- B. DASHBOARD TITLE & REFRESH -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <VBox>
                                 <children>
                                    <Label text="Dashboard" styleClass="page-title" />
                                    <Label fx:id="dateTimeLabel" text="Tuesday, 23 May 2025 · Main Outlet · Last updated just now" styleClass="page-subtitle" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                              <Button text="Refresh" styleClass="btn-secondary" onAction="#handleRefresh">
                                 <graphic>
                                    <SVGPath content="M21 12a9 9 0 11-9-9c2.52 0 4.93 1 6.74 2.74L21 8M21 3v5h-5" />
                                 </graphic>
                              </Button>
                           </children>
                        </HBox>

                        <!-- C. 3 COLUMNS CONTENT AREA WITH GRIDPLANE FOR EXACT EQUAL SPACING (33.33% each) -->
                        <GridPane hgap="15.0" VBox.vgrow="ALWAYS">
                           <columnConstraints>
                              <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS" />
                              <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS" />
                              <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="ALWAYS" />
                           </rowConstraints>
                           <children>
                              
                              <!-- COLUMN 1: TABLES & DINE-IN -->
                              <VBox spacing="12.0" styleClass="card-bg" style="-fx-padding: 15;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label text="Tables &amp; Dine-In" styleClass="column-title">
                                             <graphic>
                                                <SVGPath content="M3 3h7v7H3zm11 0h7v7h-7zm0 11h7v7h-7zM3 14h7v7H3z" scaleX="0.9" scaleY="0.9" styleClass="column-title-icon" />
                                             </graphic>
                                          </Label>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Hyperlink text="View All" styleClass="link-text" />
                                       </children>
                                    </HBox>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                       <content>
                                          <FlowPane fx:id="tablesContainer" hgap="12.0" vgap="12.0" />
                                       </content>
                                    </ScrollPane>
                                    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="5.0">
                                             <children>
                                                <Region styleClass="legend-dot, available" />
                                                <Label text="Available" styleClass="legend-text" />
                                             </children>
                                          </HBox>
                                          <HBox alignment="CENTER_LEFT" spacing="5.0">
                                             <children>
                                                <Region styleClass="legend-dot, running" />
                                                <Label text="Running" styleClass="legend-text" />
                                             </children>
                                          </HBox>
                                          <HBox alignment="CENTER_LEFT" spacing="5.0">
                                             <children>
                                                <Region styleClass="legend-dot, pending" />
                                                <Label text="Pay Pending" styleClass="legend-text" />
                                             </children>
                                          </HBox>
                                          <HBox alignment="CENTER_LEFT" spacing="5.0">
                                             <children>
                                                <Region styleClass="legend-dot, paid" />
                                                <Label text="Paid" styleClass="legend-text" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- COLUMN 2: RUNNING ORDERS -->
                              <VBox spacing="12.0" styleClass="card-bg" style="-fx-padding: 15;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label text="Pickup / Running Orders" styleClass="column-title">
                                             <graphic>
                                                <SVGPath content="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z M3 6h18 M16 10a4 4 0 01-8 0" scaleX="0.9" scaleY="0.9" styleClass="column-title-icon" />
                                             </graphic>
                                          </Label>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Hyperlink text="View All Orders" styleClass="link-text" />
                                       </children>
                                    </HBox>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                       <content>
                                          <VBox fx:id="runningOrdersContainer" spacing="10.0" />
                                       </content>
                                    </ScrollPane>
                                 </children>
                              </VBox>

                              <!-- COLUMN 3: PLATFORM & GAUGES -->
                              <VBox spacing="15.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                 <children>
                                    <!-- Top part: Platform Orders -->
                                    <VBox spacing="10.0" styleClass="card-bg" style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="6.0">
                                             <children>
                                                <Label text="Platform Orders" styleClass="column-title">
                                                   <graphic>
                                                      <SVGPath content="M3 3h7v7H3zm11 0h7v7h-7zm0 11h7v7h-7zM3 14h7v7H3z" scaleX="0.9" scaleY="0.9" styleClass="column-title-icon" />
                                                   </graphic>
                                                </Label>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane>
                                                   <children>
                                                      <SVGPath content="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" fill="TRANSPARENT" stroke="#EA580C" strokeWidth="2.0" scaleX="0.8" scaleY="0.8" />
                                                      <Region style="-fx-background-color: #EF4444; -fx-background-radius: 50%; -fx-min-width: 5px; -fx-min-height: 5px; -fx-max-width: 5px; -fx-max-height: 5px;" StackPane.alignment="TOP_RIGHT">
                                                         <StackPane.margin>
                                                            <Insets top="1.0" right="1.0" />
                                                         </StackPane.margin>
                                                      </Region>
                                                   </children>
                                                </StackPane>
                                                <Hyperlink text="View All" styleClass="link-text" />
                                             </children>
                                          </HBox>
                                          
                                          <!-- Stats row -->
                                          <HBox spacing="8.0" alignment="CENTER">
                                             <children>
                                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="stat-box, todays">
                                                   <children>
                                                      <Label fx:id="todaysOrdersLabel" text="0" styleClass="stat-number" style="-fx-text-fill: #062E1E;" />
                                                      <Label text="TODAY'S" styleClass="stat-label" style="-fx-text-fill: #475569;" />
                                                   </children>
                                                </VBox>
                                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="stat-box, active">
                                                   <children>
                                                      <Label fx:id="activeOrdersLabel" text="0" styleClass="stat-number" style="-fx-text-fill: #D97706;" />
                                                      <Label text="ACTIVE" styleClass="stat-label" style="-fx-text-fill: #B45309;" />
                                                   </children>
                                                </VBox>
                                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="stat-box, pending">
                                                   <children>
                                                      <Label fx:id="pendingOrdersLabel" text="0" styleClass="stat-number" style="-fx-text-fill: #DC2626;" />
                                                      <Label text="PENDING" styleClass="stat-label" style="-fx-text-fill: #B91C1C;" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>

                                          <!-- Platform Scrollable Orders List Container -->
                                          <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                             <content>
                                                <VBox fx:id="platformOrdersContainer" spacing="5.0" />
                                             </content>
                                          </ScrollPane>
                                       </children>
                                    </VBox>

                                    <!-- Bottom part: Pulse & Stock Out side-by-side -->
                                    <HBox spacing="10.0" prefHeight="160.0" minHeight="160.0">
                                       <children>
                                          <!-- Pulse Gauge widget (Improved KDS style) -->
                                          <VBox spacing="8.0" alignment="TOP_CENTER" styleClass="card-bg" style="-fx-padding: 12;" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label text="KDS Kitchen Pulse" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #1E293B; -fx-alignment: center-left;" maxWidth="Infinity">
                                                   <graphic>
                                                      <SVGPath content="M22 12h-4l-3 9L9 3l-3 9H2" scaleX="0.9" scaleY="0.9" styleClass="column-title-icon" style="-fx-stroke: #EF4444;" />
                                                   </graphic>
                                                </Label>
                                                <StackPane prefWidth="120.0" prefHeight="65.0" minHeight="65.0" maxHeight="65.0" VBox.vgrow="ALWAYS" style="-fx-alignment: center;">
                                                   <children>
                                                      <!-- Wrap Arcs inside Group node to prevent independent layout bounds drift -->
                                                      <Group StackPane.alignment="BOTTOM_CENTER">
                                                         <children>
                                                            <!-- Semicircle BG centered at 0.0 -->
                                                            <Arc centerX="0.0" centerY="0.0" radiusX="50.0" radiusY="50.0" startAngle="180.0" length="-180.0" fill="TRANSPARENT" stroke="#E2E8F0" strokeWidth="8.0" strokeLineCap="ROUND" />
                                                            <!-- Semicircle Value centered at 0.0 -->
                                                            <Arc fx:id="pulseGaugeArc" centerX="0.0" centerY="0.0" radiusX="50.0" radiusY="50.0" startAngle="180.0" length="-153.0" fill="TRANSPARENT" strokeWidth="8.0" strokeLineCap="ROUND" styleClass="pulse-gauge-value" />
                                                         </children>
                                                      </Group>
                                                      <VBox alignment="BOTTOM_CENTER" spacing="1.0" StackPane.alignment="BOTTOM_CENTER">
                                                         <children>
                                                            <Label fx:id="pulseLabel" text="85%" styleClass="pulse-percentage" />
                                                            <Label fx:id="pulseStatusLabel" text="HIGH LOAD" styleClass="pulse-status" />
                                                         </children>
                                                         <StackPane.margin>
                                                            <Insets bottom="2.0" />
                                                         </StackPane.margin>
                                                      </VBox>
                                                   </children>
                                                </StackPane>
                                             </children>
                                          </VBox>

                                          <!-- Stock Out widget -->
                                          <VBox spacing="8.0" styleClass="card-bg" style="-fx-padding: 12;" HBox.hgrow="ALWAYS">
                                             <children>
                                                <HBox alignment="CENTER_LEFT">
                                                   <children>
                                                      <Label text="Stock Out" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #1E293B;">
                                                         <graphic>
                                                            <SVGPath content="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16zM3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" scaleX="0.9" scaleY="0.9" styleClass="column-title-icon" />
                                                         </graphic>
                                                      </Label>
                                                      <Region HBox.hgrow="ALWAYS" />
                                                      <Label text="4" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 4px; -fx-padding: 1 5;" />
                                                   </children>
                                                </HBox>
                                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                                   <content>
                                                      <VBox fx:id="stockOutContainer" spacing="4.0" />
                                                   </content>
                                                </ScrollPane>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <!-- 2B. POS BILLING VIEW (HIDDEN BY DEFAULT) -->
                  <VBox fx:id="billingView" spacing="15.0" styleClass="main-content-area" visible="false" managed="false" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                     </padding>
                     <children>
                        <!-- Title Row -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0" visible="false" managed="false">
                           <children>
                              <VBox>
                                 <children>
                                    <Label text="Billing POS" styleClass="page-title" />
                                    <Label fx:id="billingDateTimeLabel" text="Tuesday, 23 May 2025 · Main Outlet" styleClass="page-subtitle" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <!-- 3 Columns Layout -->
                        <GridPane hgap="15.0" VBox.vgrow="ALWAYS">
                           <columnConstraints>
                              <ColumnConstraints percentWidth="22.0" hgrow="ALWAYS" />
                              <ColumnConstraints percentWidth="48.0" hgrow="ALWAYS" />
                              <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="ALWAYS" />
                           </rowConstraints>
                           <children>
                              
                              <!-- COLUMN 1: TOP 8 / FREQUENT / MODIFIERS -->
                              <VBox spacing="12.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <!-- Today's Top 8 -->
                                    <VBox spacing="10.0" styleClass="card-bg" style="-fx-padding: 12;" VBox.vgrow="ALWAYS">
                                       <children>
                                          <Label text="Today's Top 8" styleClass="column-title">
                                             <graphic>
                                                <SVGPath content="M13 17l5-5-5-5M6 17l5-5-5-5" scaleX="0.9" scaleY="0.9" styleClass="column-title-icon" />
                                             </graphic>
                                          </Label>
                                          <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                             <content>
                                                <VBox fx:id="top8ItemsContainer" spacing="6.0" />
                                             </content>
                                          </ScrollPane>
                                       </children>
                                    </VBox>

                                    <!-- Frequently Ordered -->
                                    <VBox spacing="10.0" styleClass="card-bg" style="-fx-padding: 12;" prefHeight="180.0" minHeight="180.0">
                                       <children>
                                          <Label text="Frequently Ordered" styleClass="column-title">
                                             <graphic>
                                                <SVGPath content="M12 4v16m8-8H4" scaleX="0.9" scaleY="0.9" styleClass="column-title-icon" />
                                             </graphic>
